# Скопируйте в backend/.env (файл не попадает в Git) и впишите свой ключ DaData:
# dadata.ru → Личный кабинет → «API-ключ» (тариф «Бесплатный» — до 10 000 запросов в день).
DADATA_TOKEN=

# Тестовый режим без DaData: ищет только ИНН ООО «Гранит» (3817050540).
# DADATA_MOCK=1

# Сайты, которым разрешено обращаться к API (через запятую).
ALLOWED_ORIGINS=http://localhost:4180,https://b2b.apexwoltshop.ru,http://b2b.apexwoltshop.ru
